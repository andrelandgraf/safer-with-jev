{
  "name": "safer-with-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public HTTP gates that run TypeSafe Jev, then optionally proxy a caller-chosen HTTPS model or presigned PUT.",
  "scripts": {
    "dev": "neon dev",
    "deploy": "neon deploy --env .env.local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "bun scripts/smoke.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@neon/config": "^1.7.0",
    "@neon/functions": "^0.8.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "hono": "^4.13.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.15.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
